{
  "manifest_version": 3,
  "name": "KLIK Bridge",
  "version": "0.1.0",
  "description": "Puente mínimo entre KLIK y Discord Web: solo mutear/desmutear y leer el estado del botón de mute.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://discord.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "options.html", "default_title": "KLIK Bridge" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
